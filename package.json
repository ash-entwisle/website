{
  "name": "websites",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @sites/api",
    "dev:cdn": "npm run dev -w @sites/cdn",
    "dev:root": "npm run dev -w @sites/root",
    "dev:www": "npm run dev -w @sites/www",
    "dev:links": "npm run dev -w @sites/links",


    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy:api": "npm run deploy -w @sites/api",
    "deploy:cdn": "npm run deploy -w @sites/cdn",
    "deploy:root": "npm run deploy -w @sites/root",
    "deploy:www": "npm run deploy -w @sites/www",
    "deploy:links": "npm run deploy -w @sites/links"
  },
  "dependencies": {
    "hono": "^4.13.16"
  }
}
